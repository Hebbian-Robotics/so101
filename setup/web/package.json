{
  "name": "@hebbian/so101-calibrator-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hebbian Robotics",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    "./robot-model": "./src/robot-model.ts"
  },
  "scripts": {
    "build": "pnpm typecheck && vite build && cp -R ../src/so101_setup/assets/robot ../src/so101_setup/assets/web/robot && node tools/write-notices.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "urdf-loader": "^0.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8.3.6"
  }
}
